# Backend Environment Variables

# Database
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/aviyukt?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Admin Panel Credentials (Username & Password Based)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URLs (comma-separated)
FRONTEND_URLS=http://localhost:5173,https://yourdomain.com

# Public backend URL used in emailed receipt links
BACKEND_PUBLIC_URL=http://localhost:8080

# Google OAuth (if needed)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Nodemailer (if needed)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Aviyukt NGO <your_email@gmail.com>

# Razorpay (if using payment)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
